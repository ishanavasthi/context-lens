# Copy to .env and fill in. Never commit .env.

# API
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Database. The docker compose service matches this by default. Point it at a hosted
# provider by pasting that provider's connection string here instead; TLS is enabled
# automatically for any non local host.
DATABASE_URL=postgresql://contextlens:contextlens@localhost:54329/contextlens

# TLS for hosted databases. Preferred: point DATABASE_SSL_CA_FILE at the provider's CA
# certificate, which keeps verification on. Supabase offers it under Project Settings,
# Database, SSL Configuration. Its pooler otherwise presents a chain Node does not trust.
# DATABASE_SSL_CA_FILE=./supabase-ca.crt
#
# Last resort: encrypt without verifying the certificate. Traffic is still TLS, but a
# machine in the middle could present its own certificate. Development only.
# DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Supabase. Left blank for local first development.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Extension build. Points the packed extension at the API.
VITE_API_BASE_URL=http://localhost:8787

# Development device token. The seed script registers a device whose token_hash is
# the sha256 of this value, so the extension can authenticate against a local stack
# without a sign in flow. Never use this value outside local development.
VITE_DEV_DEVICE_TOKEN=dev-device-token-0000000000000000
