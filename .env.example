# Copy to .env and fill in. Never commit .env.

# API
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Database. The docker compose service below matches this by default.
DATABASE_URL=postgresql://contextlens:contextlens@localhost:54329/contextlens

# Supabase. Left blank for local first development.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Extension build. Points the packed extension at the API.
VITE_API_BASE_URL=http://localhost:8787
