{
  "name": "contextlens",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 extension that captures browser activity and persists it through a backend API, with consent as a first class feature.",
  "license": "MIT",
  "author": "Ishan Avasthi",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test --workspace @contextlens/e2e",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate --workspace @contextlens/db",
    "db:seed": "npm run seed --workspace @contextlens/db"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "globals": "^17.8.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.62.3"
  }
}
